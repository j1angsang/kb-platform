# 复制为 .env 并填真实值；.env 含密钥，勿提交。

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=file_storage_db
# embedding 实际维度，pgvector 建表硬依赖，须与模型一致
EMBEDDING_DIM=

# ---- JWT ----
SECRET_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- 大模型 ----
LLM_MODEL=
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_SUPPORTS_VISION=true
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# ---- 对象存储 ----
# local：本地磁盘（默认）；s3：MinIO/S3。s3 模式下本地磁盘仍是解析/OCR/图片渲染缓存
STORAGE_BACKEND=local
# 本地工作缓存目录，相对路径按启动目录解析
FILE_STORAGE_DIR=storage
# MinIO 示例：127.0.0.1:9000；AWS S3 填 s3.amazonaws.com，S3_SECURE=true
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=kb-files
S3_SECURE=false
# 对象 key 前缀，最终 key=<prefix>/<stored_path>
S3_KEY_PREFIX=kb
# 本地 MinIO 首次启动自动建桶；生产建议关掉并预建桶
S3_AUTO_CREATE_BUCKET=true
S3_REGION=

# ---- 受限 Text2SQL ----
TEXT2SQL_MAX_ROWS=50
TEXT2SQL_TIMEOUT_MS=3000
# 可选：只读角色连接（postgresql+asyncpg://...）；留空则用主库 + READ ONLY 事务
TEXT2SQL_DATABASE_URL=

# ---- 上传限制 ----
MAX_FILE_SIZE=52428800
MAX_CHUNK_SIZE=5242880
MAX_TOTAL_CHUNKS=10000

# ---- 文档切分 ----
# 标题会以 [章节路径] 前缀写入 chunk；长段落优先按句子切
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---- 检索融合 ----
# rrf（默认）：倒数排名融合，只看两路名次，不要求分数同量纲
# weighted：原方案，向量分 + BM25 归一分加权
SEARCH_FUSION=rrf
# RRF 平滑常量，常用 60；越大越弱化头部名次差距
RRF_K=60
# 门控阈值：RRF 模式下作用于 _relevance_score（沿用原加权分），不是 RRF 分数
SEARCH_MIN_SCORE=0.80
SEARCH_MAX_DROP=0.015
# rrf 模式下是两路排名的权重；weighted 模式下是分数权重
SEARCH_VECTOR_WEIGHT=0.6
SEARCH_BM25_WEIGHT=0.4
SEARCH_IMAGE_SCORE_THRESHOLD=0.5

# 防盗链允许来源，逗号分隔；留空=拒绝非空 Referer
DOWNLOAD_ALLOWED_ORIGINS=http://127.0.0.1:8005,http://localhost:8005

RATE_LIMIT_BACKEND=memory
RATE_LIMIT_CHAT_MAX=10
RATE_LIMIT_CHAT_WINDOW=60
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_SEARCH_WINDOW=60
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---- 记忆与会话 ----
USE_CHECKPOINTER=true
CHECKPOINT_MESSAGE_WINDOW=20
MEMORY_ENABLED=true
LONG_TERM_MEMORY_LIMIT=10
MEMORY_EXTRACT_MAX_ITEMS=5

# ---- 扫描件 OCR 文本：默认关 ----
PDF_OCR_TEXT_ENABLED=false
PDF_OCR_TEXT_MAX_PAGES=50
PDF_OCR_TEXT_MIN_CHARS=5
PDF_OCR_TEXT_MIN_CONFIDENCE=0.6
PDF_OCR_TEXT_TIMEOUT_SECONDS=120

# ---- 重排 / Query 改写：默认关 ----
RERANK_ENABLED=false
RERANK_TOP_N=30
RERANK_MODEL=
RERANK_MIN_SCORE=0.9
RERANK_TIMEOUT_SECONDS=8
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_MODEL=
QUERY_REWRITE_TIMEOUT_SECONDS=2
QUERY_REWRITE_HISTORY_TURNS=2

# ---- 连接池 / 文档 / 日志 ----
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DOCS_ENABLED=false
LOG_LEVEL=INFO
MODEL_MAX_INPUT_TOKENS=1000000
SUMMARY_TRIGGER_FRACTION=0.8
SUMMARY_MODEL=
SUMMARY_PROMPT=

TRUSTED_PROXY=false
UPLOAD_STALE_HOURS=24
UPLOAD_CLEANUP_INTERVAL_SECONDS=3600
EMBEDDING_CACHE_ENABLED=false
EMBEDDING_CACHE_TTL=604800

# ---- 知识图谱（默认关闭；开启要求 RERANK_ENABLED=true，否则启动直接报错）----
KG_ENABLED=false
# 1~3，递归 CTE 靠它防环；2 跳以上在中文企业文档上噪声大于收益
KG_MAX_HOPS=2
# 图通道每次最多补多少候选进 rerank 池
KG_CANDIDATE_TOP_K=12
# 实体链接阈值，0.82 为实测标定值；详见 docs/GRAPH_IMPLEMENTATION.md §8.4
KG_LINK_MIN_SCORE=0.82
KG_LINK_TOP_N=5
# 泛实体停用词：出现在几乎每个 query 里、对定位零区分度的词，不参与链接
KG_LINK_STOPWORDS=员工,公司,人员,部门,领导,同事,本人,大家,职工,全体,相关人员
# 实体自动合并阈值，调低会把「技术部」和「技术支持部」并成一个
KG_MERGE_MIN_SCORE=0.92
# 单文档最多抽多少 chunk / 抽取并发
KG_MAX_CHUNKS_PER_DOC=200
KG_EXTRACT_CONCURRENCY=4
KG_EXTRACT_TIMEOUT_SECONDS=45
KG_EXTRACT_MODEL=
# 任务队列
KG_JOB_LEASE_SECONDS=900
KG_JOB_MAX_ATTEMPTS=2
KG_JOB_POLL_SECONDS=15
